
(rules PCB pcb.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute off)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.7)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.3)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    GND /SDA +3.3V /SCL "/BMV080_INT" VBAT /L2 /L1
    /FB "unconnected-(U1-GPIO18-Pad16)" "unconnected-(U1-GPIO8-Pad10)" "unconnected-(U1-EN{slash}CHIP_PU-Pad3)" "unconnected-(U1-GPIO2{slash}ADC1_CH2-Pad27)" "unconnected-(U1-GPIO22-Pad20)" "/SHARP_LED" "unconnected-(U1-MTDI{slash}GPIO5{slash}ADC1_CH5-Pad5)"
    "unconnected-(U1-U0RXD{slash}GPIO17-Pad24)" "unconnected-(U1-GPIO3{slash}ADC1_CH3-Pad26)" "unconnected-(U1-GPIO20-Pad18)" "unconnected-(U1-GPIO9-Pad15)" "unconnected-(U1-GPIO23-Pad21)" "/MSA_INT1" "unconnected-(U1-GPIO12{slash}USB_D--Pad13)" "unconnected-(U1-GPIO19-Pad17)"
    "unconnected-(U1-GPIO13{slash}USB_D+-Pad14)" "unconnected-(U1-NC-Pad22)" "unconnected-(U1-GPIO11-Pad12)" "unconnected-(U1-GPIO15-Pad23)" "/SHARP_AOUT" "unconnected-(U1-U0TXD{slash}GPIO16-Pad25)" "unconnected-(U1-GPIO21-Pad19)" "unconnected-(U2-CSB-Pad2)"
    "unconnected-(U2-SDO-Pad5)" "unconnected-(U3-NC-Pad10)" "unconnected-(U3-SDO-Pad7)" "unconnected-(U3-INT2-Pad9)" "unconnected-(U3-NC-Pad12)" "unconnected-(U3-NC-Pad11)" "unconnected-(U4-GND-Pad3)" "unconnected-(U5-PG-Pad12)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)